{
  "manifest_version": 3,
  "name": "sovereign-browser — si-didy rail",
  "version": "0.1.0",
  "description": "Your governed AI, operating any site alongside you. One owned agent instead of twenty rented per-app AIs.",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "action": { "default_title": "Open the si-didy rail" }
}
